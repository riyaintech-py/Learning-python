# DAY 4 - OPERATORS (DAY 4)
# Operators are symbols to do work.

# a) Arithmetic Operator - for maths
# + - * / % **
a = 10
b = 3
print(a + b)  # 13
print(a - b)  # 7
print(a * b)  # 30
print(a / b)  # 3.33

# b) Assignment Operator - to store value
# = += -=
x = 5
x += 1  # same as x = x + 1
print(x)

# c) Comparison Operator - to compare
# == != > < >= <=
print(5 == 5)  # True
print(5 > 3)   # True

# d) Membership Operator - to check if value is inside list
# in, not in
my_list = [8, 6, 9, 1]
print(5 in my_list)      # False
print(6 in my_list)      # True
print(5 not in my_list)  # True

# e) Logical Operator
# and, or, not
print(True and False) # False
print(True or False)  # True

# f) Bitwise Operator
# Main for binary numbers like 0101, 0011
# & - AND
# | - OR
# ^ - XOR
# ~ - NOT
# << - Left shift moves bits to left
# >> - Right shift moves bits to right
a = 5  # 0101
b = 3  # 0011
print(a & b)  # 1
print(a | b)  # 7
print(a << 1) # 10 -> moves bits to left
print(a >> 1) # 2  -> moves bits to right

# Use: fast calculation, games and low level coding
